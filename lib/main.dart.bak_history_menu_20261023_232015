            _buildDetailRow('Total Capital', '\$${total.toStringAsFixed(2)}', Colors.white, isBold: true),
          ],
        ),
      ),
    );
  }

  Widget _buildJournal() {
    final List journal = widget.data['journal'] ?? [];
    if (journal.isEmpty) return const Center(child: Text('Journal is empty', style: TextStyle(color: Colors.grey)));
    return ListView.builder(
      padding: const EdgeInsets.all(16),
      itemCount: journal.length,
      itemBuilder: (context, index) {
        final j = journal[index];
        final type = j['type'] ?? 'INFO';
        final msg = j['message'] ?? '';
        final time = j['time'] ?? '';
        Color c = Colors.grey;
        IconData icon = Icons.info_outline;
        if (type.contains('BUY')) { c = green; icon = Icons.arrow_downward; }
        else if (type.contains('SELL')) { c = red; icon = Icons.arrow_upward; }
        else if (type.contains('DCA')) { c = Colors.blue; icon = Icons.repeat; }
        return Container(
          margin: const EdgeInsets.only(bottom: 8),
          padding: const EdgeInsets.all(12),
          decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(8), border: Border.all(color: borderColor)),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Icon(icon, size: 16, color: c),
              const SizedBox(width: 8),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('$type - $time', style: TextStyle(fontSize: 11, color: c, fontWeight: FontWeight.bold)),
                    const SizedBox(height: 4),
                    Text(msg, style: const TextStyle(fontSize: 12, color: Colors.white)),
                  ],
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  Widget _buildDetailRow(String label, String value, Color valColor, {bool isBold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(color: Colors.grey, fontSize: 13)),
          Text(value, style: TextStyle(color: valColor, fontSize: 14, fontWeight: isBold ? FontWeight.bold : FontWeight.w600)),
        ],
      ),
    );
  }
}

// ================= STATS SCREEN =================
class StatsScreen extends StatefulWidget {
  final String token;
  const StatsScreen({super.key, required this.token});

  @override
  State<StatsScreen> createState() => _StatsScreenState();
}

class _StatsScreenState extends State<StatsScreen> {
  bool _isLoading = true;
  Map<String, dynamic> _data = {};
  List<FlSpot> _rawSpots = [];
  List<FlSpot> _dietzSpots = [];
  List<String> _chartLabels = [];
  double _changePct = 0.0;

  final Color cardBg = const Color(0xFF101722);
  final Color borderColor = const Color(0xFF202d42);
  final Color accent = const Color(0xFF00d9ff);
  final Color green = const Color(0xFF10b981);
  final Color red = const Color(0xFFef4444);

  @override
  void initState() {
    super.initState();
    _fetchData();
  }

  Future<void> _fetchData() async {
    try {
      final res = await http.get(
        Uri.parse('http://100.77.27.80:8553/api/stats/performance'),
        headers: {'Authorization': 'Bearer ${widget.token}'},
      );
      if (res.statusCode == 200) {
        final d = jsonDecode(res.body);
        final chart = d['chart'] ?? {};
        final rawList = chart['raw'] as List? ?? [];
        final dietzList = chart['dietz'] as List? ?? [];
        final labelsList = chart['labels'] as List? ?? [];

        List<FlSpot> raw = [];
        for (int i = 0; i < rawList.length; i++) {
          double v = double.tryParse(rawList[i][1].toString()) ?? 0.0;
          if (v > 0) raw.add(FlSpot(i.toDouble(), v));
        }
        List<FlSpot> dietz = [];
        for (int i = 0; i < dietzList.length; i++) {
          double v = double.tryParse(dietzList[i][1].toString()) ?? 0.0;
          if (v > 0) dietz.add(FlSpot(i.toDouble(), v));
        }

        setState(() {
          _data = d;
          _rawSpots = raw;
          _dietzSpots = dietz;
          _chartLabels = labelsList.map((e) => e.toString()).toList();
          _changePct = (d['trend']?['net_pct'] as num?)?.toDouble() ?? 0.0;
          _isLoading = false;
        });
      } else {
        setState(() => _isLoading = false);
      }
    } catch (e) {
      setState(() => _isLoading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return Scaffold(
        backgroundColor: const Color(0xFF080d14),
        appBar: AppBar(
          backgroundColor: cardBg,
          leading: IconButton(icon: Icon(Icons.arrow_back, color: accent), onPressed: () => Navigator.pop(context)),
          title: Text('Capital Performance', style: TextStyle(color: accent, fontWeight: FontWeight.bold)),
        ),
        body: const Center(child: CircularProgressIndicator(color: Color(0xFF00d9ff))),
      );
    }

    final periods = _data['periods'] ?? {};
    final extremes = _data['extremes'] ?? {};
    final trend = _data['trend'] ?? {};

    return Scaffold(
      backgroundColor: const Color(0xFF080d14),
      appBar: AppBar(
        backgroundColor: cardBg,
        elevation: 0,
        leading: IconButton(icon: Icon(Icons.arrow_back, color: accent), onPressed: () => Navigator.pop(context)),
        title: Text('Capital Performance', style: TextStyle(color: accent, fontWeight: FontWeight.bold, fontSize: 18)),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // 4 Period Cards
            _buildPeriodCard('Today', '1d', periods['1d']),
            const SizedBox(height: 8),
            _buildPeriodCard('Week', '1w', periods['1w']),
            const SizedBox(height: 8),
            _buildPeriodCard('Month', '1mo', periods['1mo']),
            const SizedBox(height: 8),
            _buildPeriodCard('Year', '1y', periods['1y']),
            const SizedBox(height: 16),

            // Chart Title
            Text('CHART', style: TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: accent)),
            const SizedBox(height: 8),

            // Big Chart (transparent - Flet style)
            Container(
              height: 160,
              padding: const EdgeInsets.all(8),
              child: Column(
                children: [
                  Expanded(
                    child: _rawSpots.isEmpty
                        ? const Center(child: Text('No chart data', style: TextStyle(color: Colors.grey, fontSize: 11)))
                        : LineChart(
                            LineChartData(
                              gridData: FlGridData(
                                show: true,
                                drawVerticalLine: false,
                                getDrawingHorizontalLine: (value) => const FlLine(
                                  color: Color(0xFF2d3a52),
                                  strokeWidth: 1,
                                  dashArray: [3, 3],
                                ),
                              ),
                              titlesData: const FlTitlesData(show: false),
                              borderData: FlBorderData(show: false),
                              minX: 0,
                              maxX: (_rawSpots.length - 1).toDouble() > 0 ? (_rawSpots.length - 1).toDouble() : 1,
                              lineBarsData: [
                                LineChartBarData(
                                  spots: _rawSpots,
                                  isCurved: true,
                                  color: _changePct >= 0 ? green : red,
                                  barWidth: 2,
                                  dotData: const FlDotData(show: false),
                                ),
                                if (_dietzSpots.isNotEmpty)
                                  LineChartBarData(
                                    spots: _dietzSpots,
                                    isCurved: true,
                                    color: accent,
                                    barWidth: 1,
                                    dotData: const FlDotData(show: false),
                                    dashArray: [4, 3],
                                  ),
                              ],
                            ),
                          ),
                  ),
                  if (_chartLabels.isNotEmpty) ...[
                    const SizedBox(height: 4),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: _buildStatsChartLabels(),
                    ),
                  ],
                ],
              ),
            ),
            const SizedBox(height: 16),

            // Extremes Card
            if (extremes.isNotEmpty) ...[
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(10), border: Border.all(color: borderColor)),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('EXTREMES', style: TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: accent)),
                    const Divider(color: Color(0xFF202d42), height: 16),
                    _buildRow('Peak', '\$${extremes['peak_val']?.toStringAsFixed(2)}  ${extremes['peak_str']}'),
                    _buildRow('Trough', '\$${extremes['trough_val']?.toStringAsFixed(2)}  ${extremes['trough_str']}'),
                    _buildRow('Range', '\$${extremes['range_dollar']?.toStringAsFixed(2)}  (${extremes['range_pct']?.toStringAsFixed(2)}%)', Colors.orange),
                  ],
                ),
              ),
              const SizedBox(height: 12),
            ],

            // Trend Card
            if (trend.isNotEmpty) ...[
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(10), border: Border.all(color: borderColor)),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('TREND', style: TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: accent)),
                    const Divider(color: Color(0xFF202d42), height: 16),
                    _buildRow('Start', '\$${trend['start_val']?.toStringAsFixed(2)}'),
                    _buildRow('End', '\$${trend['end_val']?.toStringAsFixed(2)}'),
                    _buildRow(
                      'Net',
                      '${(trend['net_dollar'] ?? 0) >= 0 ? '+' : ''}\$${(trend['net_dollar'] ?? 0).toStringAsFixed(2)}  (${(trend['net_pct'] ?? 0) >= 0 ? '+' : ''}${(trend['net_pct'] ?? 0).toStringAsFixed(2)}%)',
                      (trend['net_dollar'] ?? 0) >= 0 ? green : red,
                    ),
                  ],
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }

  List<Widget> _buildStatsChartLabels() {
    List<Widget> items = [];
    for (int i = 0; i < _chartLabels.length; i++) {
      if (i > 0) {
        for (int d = 0; d < 3; d++) {
          items.add(Container(
            width: 1, height: 3,
            margin: const EdgeInsets.symmetric(horizontal: 1),
            color: const Color(0xFF3d4a5f),
          ));
        }
      }
      items.add(Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Container(
            width: 4, height: 4,
            decoration: const BoxDecoration(
              color: Color(0xFF00d9ff),
              shape: BoxShape.circle,
            ),
          ),
          const SizedBox(height: 1),
          Text(_chartLabels[i], style: const TextStyle(fontSize: 7, color: Color(0xFF94a3b8))),
        ],
      ));
    }
    return items;
  }

  Widget _buildPeriodCard(String label, String code, dynamic data) {
    double pct = (data?['pct'] ?? 0.0).toDouble();
    double usd = (data?['usd'] ?? 0.0).toDouble();
    Color c = pct >= 0 ? green : red;

    return InkWell(
      onTap: () {
        Navigator.push(
          context,
          MaterialPageRoute(builder: (c) => PeriodHistoryScreen(
            token: widget.token,
            period: code,
            title: label,
          )),
        );
      },
      borderRadius: BorderRadius.circular(8),
      child: Container(
        padding: const EdgeInsets.all(10),
        decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(8), border: Border.all(color: borderColor)),
        child: Row(
          children: [
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(label, style: const TextStyle(fontSize: 11.5, fontWeight: FontWeight.bold, color: Colors.white)),
                Text(code, style: const TextStyle(fontSize: 9, color: Colors.grey)),
              ],
            ),
            const Spacer(),
            Column(
              crossAxisAlignment: CrossAxisAlignment.end,
              children: [
                Text('${pct >= 0 ? '+' : ''}${pct.toStringAsFixed(2)}%', style: TextStyle(fontSize: 12.5, fontWeight: FontWeight.bold, color: c)),
                Text('${usd >= 0 ? '+' : ''}\$${usd.toStringAsFixed(2)}', style: TextStyle(fontSize: 10, color: c)),
              ],
            ),
            const SizedBox(width: 6),
            const Icon(Icons.chevron_right, color: Color(0xFF475569), size: 15),
          ],
        ),
      ),
    );
  }

  Widget _buildRow(String label, String value, [Color? color]) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 3),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(fontSize: 11, color: Colors.grey)),
          Text(value, style: TextStyle(fontSize: 11, fontWeight: FontWeight.bold, color: color ?? Colors.white)),
        ],
      ),
    );
  }
}

