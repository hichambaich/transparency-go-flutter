// ================= SEARCH ASSET SCREEN =================
class SearchAssetScreen extends StatefulWidget {
  const SearchAssetScreen({super.key});

  @override
  State<SearchAssetScreen> createState() => _SearchAssetScreenState();
}

class _SearchAssetScreenState extends State<SearchAssetScreen> {
  final _searchCtrl = TextEditingController();
  bool _isLoading = false;
  String _error = '';

  final Color cardBg = const Color(0xFF101722);
  final Color borderColor = const Color(0xFF202d42);
  final Color accent = const Color(0xFF00d9ff);

  Future<void> _doSearch() async {
    String q = _searchCtrl.text.trim().toUpperCase();
    if (q.isEmpty) return;
    if (!q.contains('/')) q = '$q/USDT';

    setState(() { _isLoading = true; _error = ''; });

    try {
      final prefs = await SharedPreferences.getInstance();
      final token = prefs.getString('auth_token') ?? '';
      final headers = {'Authorization': 'Bearer $token'};
      
      final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/search?symbol=$q'), headers: headers);
      
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);
        if (data['asset'] == null) {
          setState(() { _error = 'Asset not found'; _isLoading = false; });
        } else {
          setState(() { _isLoading = false; });
          Navigator.push(context, MaterialPageRoute(builder: (c) => AssetDetailsScreen(
            asset: data['asset'],
            experience: data['experience'],
            history: data['history'] ?? [],
          )));
        }
      } else {
        setState(() { _error = 'Failed to load data (Code: ${res.statusCode})'; _isLoading = false; });
      }
    } catch (e) {
      setState(() { _error = 'Connection error'; _isLoading = false; });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF080d14),
      appBar: AppBar(
        backgroundColor: cardBg,
        leading: IconButton(icon: Icon(Icons.arrow_back, color: accent), onPressed: () => Navigator.pop(context)),
        title: const Text('Search', style: TextStyle(color: Color(0xFF00d9ff), fontWeight: FontWeight.bold)),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: [
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(12), border: Border.all(color: borderColor)),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text('Search Asset', style: TextStyle(color: accent, fontSize: 16, fontWeight: FontWeight.bold)),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _searchCtrl,
                    style: const TextStyle(color: Colors.white),
                    decoration: InputDecoration(
                      hintText: 'Enter symbol (e.g. BTC)',
                      hintStyle: const TextStyle(color: Colors.grey),
                      filled: true,
                      fillColor: const Color(0xFF080d14),
                      enabledBorder: OutlineInputBorder(borderSide: BorderSide(color: accent, width: 1.5), borderRadius: BorderRadius.circular(8)),
                      focusedBorder: OutlineInputBorder(borderSide: BorderSide(color: accent, width: 2), borderRadius: BorderRadius.circular(8)),
                    ),
                    onSubmitted: (_) => _doSearch(),
                  ),
                  const SizedBox(height: 16),
                  if (_isLoading)
                    const Center(child: CircularProgressIndicator(color: Color(0xFF00d9ff)))
                  else if (_error.isNotEmpty)
                    Center(child: Text(_error, style: const TextStyle(color: Colors.red))),
                  Center(
                    child: ElevatedButton(
                      onPressed: _doSearch,
                      style: ElevatedButton.styleFrom(
                        backgroundColor: accent,
                        foregroundColor: Colors.black,
                        padding: const EdgeInsets.symmetric(horizontal: 30, vertical: 12),
                        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                      ),
                      child: const Text('Search', style: TextStyle(fontWeight: FontWeight.bold)),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}


// ================= ASSET DETAILS SCREEN =================
class AssetDetailsScreen extends StatelessWidget {
  final Map<String, dynamic> asset;
  final Map<String, dynamic>? experience;
  final List<dynamic> history;

  const AssetDetailsScreen({super.key, required this.asset, this.experience, required this.history});

  final Color cardBg = const Color(0xFF101722);
  final Color borderColor = const Color(0xFF202d42);
  final Color accent = const Color(0xFF00d9ff);
  final Color green = const Color(0xFF10b981);
  final Color red = const Color(0xFFef4444);
  final Color gold = const Color(0xFFf0b90b);

  String _fmtNum(dynamic val, {int decimals = 2}) {
    if (val == null) return '0';
    double d = double.tryParse(val.toString()) ?? 0.0;
    return d.toStringAsFixed(decimals);
  }

  String _fmtPrice(dynamic val) {
    if (val == null) return '\$0';
    double d = double.tryParse(val.toString()) ?? 0.0;
    if (d >= 1000000) return '\$${(d / 1000000).toStringAsFixed(0)},${(d % 1000000).toStringAsFixed(0).padLeft(6, '0')}';
    if (d >= 1000) return '\$${d.toStringAsFixed(0).replaceAllMapped(RegExp(r'(\d{1,3})(?=(\d{3})+(?!\d))'), (m) => '${m[1]},')}';
    return '\$${d.toStringAsFixed(2)}';
  }

  Widget _buildRow(String label, String value, {Color? valColor, bool isBold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 4),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(color: Colors.grey, fontSize: 12)),
          Text(value, style: TextStyle(color: valColor ?? Colors.white, fontSize: 12, fontWeight: isBold ? FontWeight.bold : FontWeight.w600)),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    String symbol = asset['symbol'] ?? 'UNKNOWN';
    String status = asset['status'] ?? 'UNKNOWN';
    Color statusColor = status == 'ACTIVE' ? green : red;

    return Scaffold(
      backgroundColor: const Color(0xFF080d14),
      appBar: AppBar(
        backgroundColor: cardBg,
        leading: IconButton(icon: Icon(Icons.arrow_back, color: accent), onPressed: () => Navigator.pop(context)),
        title: Text(symbol, style: TextStyle(color: accent, fontWeight: FontWeight.bold)),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            // Asset Info Card
            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(12), border: Border.all(color: borderColor)),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('[ASSET DETAIL]', style: TextStyle(color: Colors.grey, fontSize: 11)),
                  const SizedBox(height: 8),
                  _buildRow('Asset', symbol),
                  _buildRow('Status', status, valColor: statusColor),
                  _buildRow('Confidence', '${_fmtNum(asset['confidence_score'])}/100', valColor: green),
                  _buildRow('Health', '${_fmtNum(asset['health_score'])}/100', valColor: green),
                  _buildRow('Liquidity', _fmtPrice(asset['liquidity_24h'])),
                  _buildRow('Max DD', '-${_fmtNum(asset['max_drawdown'])}%', valColor: red),
                  _buildRow('Current DD', '-${_fmtNum(asset['current_drawdown'])}%', valColor: gold),
                  _buildRow('DD Duration', '${_fmtNum(asset['current_dd_duration_days'])} days'),
                  _buildRow('Liquidity Trend', asset['liquidity_trend'] ?? 'N/A'),
                  _buildRow('Valid Exchanges', '${asset['valid_exchanges'] ?? 0}'),
                  _buildRow('Model', '${asset['model_version'] ?? 'N/A'}'),
                ],
              ),
            ),
            const SizedBox(height: 12),

            // Trade Experience Card
            if (experience != null)
              Container(
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(12), border: Border.all(color: borderColor)),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('Trade Experience', style: TextStyle(color: accent, fontWeight: FontWeight.bold, fontSize: 13)),
                    const Divider(color: Color(0xFF202d42), height: 20),
                    _buildRow('Total Positions', '${experience!['total_positions'] ?? 0}'),
                    _buildRow('Wins / Losses', '${experience!['winning_positions'] ?? 0} / ${experience!['losing_positions'] ?? 0}'),
                    _buildRow('Total Net PnL', '\$${_fmtNum(experience!['total_net_pnl'], decimals: 4)}', valColor: green),
                    _buildRow('Avg PnL / trade', '\$${_fmtNum(experience!['avg_pnl'], decimals: 4)}', valColor: green),
                    _buildRow('Avg Hold', '${_fmtNum(experience!['avg_hold_minutes'], decimals: 1)} min'),
                    _buildRow('Avg / Max DCA', '${_fmtNum(experience!['avg_dca_levels'])} / ${experience!['max_dca_levels'] ?? 0}'),
                    _buildRow('Experience Score', '${_fmtNum(experience!['experience_score'], decimals: 4)}', valColor: const Color(0xFFa78bfa)),
                  ],
                ),
              ),
            const SizedBox(height: 12),

            // Status History Card
            if (history.isNotEmpty)
              Container(
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(12), border: Border.all(color: borderColor)),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('Status History (${history.length})', style: TextStyle(color: accent, fontWeight: FontWeight.bold, fontSize: 13)),
                    const Divider(color: Color(0xFF202d42), height: 20),
                    ...history.map((h) {
                      String oldSt = h['old_status'] ?? '';
                      String newSt = h['new_status'] ?? '';
                      String reason = h['reason'] ?? '';
                      double ts = double.tryParse(h['timestamp']?.toString() ?? '0') ?? 0;
                      String dateStr = '';
                      if (ts > 0) {
                        final dt = DateTime.fromMillisecondsSinceEpoch((ts * 1000).toInt());
                        dateStr = '${dt.day.toString().padLeft(2, '0')}-${dt.month.toString().padLeft(2, '0')}-${dt.year} ${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}:${dt.second.toString().padLeft(2, '0')}';
                      }
                      return Padding(
                        padding: const EdgeInsets.only(bottom: 12),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              mainAxisAlignment: MainAxisAlignment.spaceBetween,
                              children: [
                                Text('$oldSt -> $newSt', style: TextStyle(color: green, fontSize: 11, fontWeight: FontWeight.bold)),
                                Text(dateStr, style: const TextStyle(color: Colors.grey, fontSize: 9)),
                              ],
                            ),
                            if (reason.isNotEmpty)
                              Text(reason, style: const TextStyle(color: Colors.grey, fontSize: 9)),
                          ],
                        ),
                      );
                    }).toList(),
                  ],
                ),
              ),
          ],
        ),
      ),
    );
  }
}


// ================= ACTIVE UNIVERSE SCREEN =================
class ActiveUniverseScreen extends StatefulWidget {
  const ActiveUniverseScreen({super.key});

  @override
  State<ActiveUniverseScreen> createState() => _ActiveUniverseScreenState();
}

class _ActiveUniverseScreenState extends State<ActiveUniverseScreen> {
  List<dynamic> _assets = [];
  bool _isLoading = true;
  String _error = '';

  final Color cardBg = const Color(0xFF101722);
  final Color borderColor = const Color(0xFF202d42);
  final Color accent = const Color(0xFF00d9ff);

  @override
  void initState() {
    super.initState();
    _fetchUniverse();
  }

  Future<void> _fetchUniverse() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final token = prefs.getString('auth_token') ?? '';
      final res = await http.get(
        Uri.parse('http://100.77.27.80:8553/api/active_universe'),
        headers: {'Authorization': 'Bearer $token'},
      );

      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);
        setState(() {
          _assets = data['assets'] ?? [];
          _isLoading = false;
        });
      } else {
        setState(() { _error = 'Failed to load (Code: ${res.statusCode})'; _isLoading = false; });
      }
    } catch (e) {
      setState(() { _error = 'Connection error'; _isLoading = false; });
    }
  }

  String _formatAdmitted(dynamic ts) {
    if (ts == null) return 'N/A';
    double v = double.tryParse(ts.toString()) ?? 0.0;
    if (v <= 0) return 'N/A';
    final dt = DateTime.fromMillisecondsSinceEpoch((v * 1000).toInt());
    return '${dt.day.toString().padLeft(2, '0')}/${dt.month.toString().padLeft(2, '0')}/${dt.year} ${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}:${dt.second.toString().padLeft(2, '0')}';
  }

  void _openAssetDetails(String symbol) async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final token = prefs.getString('auth_token') ?? '';
      final res = await http.get(
        Uri.parse('http://100.77.27.80:8553/api/search?symbol=$symbol'),
        headers: {'Authorization': 'Bearer $token'},
      );
      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);
        if (data['asset'] != null) {
          Navigator.push(context, MaterialPageRoute(builder: (c) => AssetDetailsScreen(
            asset: data['asset'],
            experience: data['experience'],
            history: data['history'] ?? [],
          )));
        }
      }
    } catch (_) {}
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF080d14),
      appBar: AppBar(
        backgroundColor: cardBg,
        leading: IconButton(icon: Icon(Icons.arrow_back, color: accent), onPressed: () => Navigator.pop(context)),
        title: const Text('Active Universe', style: TextStyle(color: Color(0xFF00d9ff), fontWeight: FontWeight.bold)),
      ),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator(color: Color(0xFF00d9ff)))
          : _error.isNotEmpty
              ? Center(child: Text(_error, style: const TextStyle(color: Colors.red)))
              : ListView(
                  padding: const EdgeInsets.all(16),
                  children: [
                    Text('${_assets.length} ACTIVE assets', style: const TextStyle(color: Colors.grey, fontSize: 12)),
                    const SizedBox(height: 10),
                    ..._assets.map((a) {
                      String sym = a['symbol'] ?? '';
                      double conf = double.tryParse(a['confidence_score'].toString()) ?? 0.0;
                      double health = double.tryParse(a['health_score'].toString()) ?? 0.0;
                      double priority = double.tryParse(a['priority'].toString()) ?? 0.0;
                      double exp = double.tryParse(a['experience_score'].toString()) ?? 0.0;
                      String admitted = _formatAdmitted(a['admitted_at']);

                      return InkWell(
                        onTap: () => _openAssetDetails(sym),
                        child: Container(
                          margin: const EdgeInsets.only(bottom: 10),
                          padding: const EdgeInsets.all(12),
                          decoration: BoxDecoration(color: cardBg, borderRadius: BorderRadius.circular(10), border: Border.all(color: borderColor)),
                          child: Row(
                            children: [
                              CircleAvatar(
                                radius: 14,
                                backgroundColor: const Color(0xFF080d14),
                                child: Text(sym.isNotEmpty ? sym[0] : '?', style: const TextStyle(fontSize: 12, color: Colors.white, fontWeight: FontWeight.bold)),
                              ),
                              const SizedBox(width: 12),
                              Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(sym, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 13)),
                                    Text('CS ${conf.toStringAsFixed(2)} · HS ${health.toStringAsFixed(2)}', style: const TextStyle(color: Colors.grey, fontSize: 10)),
                                    Text('Admitted $admitted', style: const TextStyle(color: Color(0xFF475569), fontSize: 9)),
                                  ],
                                ),
                              ),
                              Column(
                                crossAxisAlignment: CrossAxisAlignment.end,
                                children: [
                                  Text(priority.toStringAsFixed(2), style: TextStyle(color: accent, fontWeight: FontWeight.bold, fontSize: 13)),
                                  Text('exp ${exp.toStringAsFixed(4)}', style: const TextStyle(color: Colors.grey, fontSize: 9)),
                                ],
                              ),
                              const SizedBox(width: 6),
                              const Icon(Icons.chevron_right, color: Color(0xFF475569), size: 16),
                            ],
                          ),
                        ),
                      );
                    }).toList(),
                  ],
                ),
    );
  }
}
