  final Color gold = const Color(0xFFf0b90b);

  final String bnbLogoUrl = "https://cdn.jsdelivr.net/gh/spothq/cryptocurrency-icons@master/128/color/bnb.png";

  @override
  void initState() {
    super.initState();
    _fetchData();
    _pollingTimer = Timer.periodic(const Duration(seconds: 3), (_) => _fetchData(isPolling: true));
  }


  double get _minY {
    if (_spots.isEmpty) return 0;
    double minVal = _spots.map((s) => s.y).reduce((a, b) => a < b ? a : b);
    double maxVal = _spots.map((s) => s.y).reduce((a, b) => a > b ? a : b);
    if (maxVal - minVal < 0.0001) maxVal = minVal + 0.01;
    double pad = (maxVal - minVal) * 0.05;
    return minVal - pad;
  }

  double get _maxY {
    if (_spots.isEmpty) return 1;
    double minVal = _spots.map((s) => s.y).reduce((a, b) => a < b ? a : b);
    double maxVal = _spots.map((s) => s.y).reduce((a, b) => a > b ? a : b);
    if (maxVal - minVal < 0.0001) maxVal = minVal + 0.01;
    double pad = (maxVal - minVal) * 0.05;
    return maxVal + pad;
  }

  @override
  void dispose() {
    _pollingTimer?.cancel();
    super.dispose();
  }

  Future<void> _fetchData({bool isPolling = false}) async {
    if (!isPolling) setState(() { _isLoading = true; _errorMsg = ''; });

    try {
      final headers = {'Authorization': 'Bearer ${widget.token}'};
      final resDash = await http.get(Uri.parse('http://100.77.27.80:8553/api/dashboard'), headers: headers);
      if (resDash.statusCode == 401) {
        setState(() { _errorMsg = "Session expired. Please log in again."; _isLoading = false; });
        _pollingTimer?.cancel();
        widget.onLogout();
        return;
      }
      if (resDash.statusCode == 200) {
        setState(() => _data = jsonDecode(resDash.body));
      }

      final resChart = await http.get(Uri.parse('http://100.77.27.80:8553/api/trend_history?period=$_currentPeriod'), headers: headers);
      if (resChart.statusCode == 200) {
        final pts = jsonDecode(resChart.body)['points'] as List;
        List<FlSpot> newSpots = [];
        for (int i = 0; i < pts.length; i++) {
          double v = double.tryParse(pts[i][1].toString()) ?? 0.0;
          if (v > 0) newSpots.add(FlSpot(i.toDouble(), v));
        }
        
        // Flet Logic: Downsample to max 80 points
        if (newSpots.length > 80) {
          int step = (newSpots.length / 80).ceil();
          List<FlSpot> reduced = [];
          for (int i = 0; i < newSpots.length; i += step) {
            reduced.add(newSpots[i]);
          }
          if (reduced.isNotEmpty && reduced.last.x != newSpots.last.x) {
            reduced.add(newSpots.last);
          }
          newSpots = reduced;
        }
        setState(() => _spots = newSpots);
      }

      if (!isPolling) setState(() => _isLoading = false);
    } catch (e) {
      if (!isPolling) setState(() { _errorMsg = 'Connection error: $e'; _isLoading = false; });
    }
  }

  String formatPct(double val) => '${val >= 0 ? '+' : ''}${val.toStringAsFixed(2)}%';
  String formatUsd(double val) => '${val >= 0 ? '+' : ''}\$${val.toStringAsFixed(2)}';

