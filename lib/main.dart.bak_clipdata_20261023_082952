class _StatDetailScreenState extends State<StatDetailScreen> {
  bool _isLoading = true;
  Map<String, dynamic> _extraData = {};
  List<dynamic> _trades = [];
  String _errorMsg = '';

  final Color cardBg = const Color(0xFF101722);
  final Color borderColor = const Color(0xFF202d42);
  final Color accent = const Color(0xFF00d9ff);
  final Color green = const Color(0xFF10b981);
  final Color red = const Color(0xFFef4444);
  final Color gold = const Color(0xFFf0b90b);

  @override
  void initState() {
    super.initState();
    _fetchData();
  }

  Future<void> _fetchData() async {
    try {
      final headers = {'Authorization': 'Bearer ${widget.token}'};

      if (widget.title == 'Closed Trades' || widget.title == 'Profit Trades') {
        final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/history'), headers: headers);
        if (res.statusCode == 200) {
          final allTrades = jsonDecode(res.body)['trades'] ?? [];
          setState(() {
            if (widget.title == 'Profit Trades') {
              _trades = allTrades.where((t) => (t['realized_profit_usdt'] ?? 0.0) > 0).toList();
            } else {
              _trades = allTrades;
            }
            _isLoading = false;
          });
        } else {
          setState(() { _errorMsg = 'Failed to load trades'; _isLoading = false; });
        }
      } else if (widget.title == 'All-Time PnL Range') {
        final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/stats/pnl_range'), headers: headers);
        if (res.statusCode == 200) {
          setState(() { _extraData = jsonDecode(res.body); _isLoading = false; });
        } else {
          setState(() { _errorMsg = 'Failed'; _isLoading = false; });
        }
      } else if (widget.title == 'Cost & Efficiency') {
        final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/stats/fees'), headers: headers);
        if (res.statusCode == 200) {
          setState(() { _extraData = jsonDecode(res.body); _isLoading = false; });
        } else {
          setState(() { _errorMsg = 'Failed'; _isLoading = false; });
        }
      } else if (widget.title == 'BNB Fees Reserve') {
        final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/bnb/status'), headers: headers);
        if (res.statusCode == 200) {
          setState(() { _extraData = jsonDecode(res.body); _isLoading = false; });
        } else {
          setState(() { _errorMsg = 'Failed'; _isLoading = false; });
        }
      } else if (widget.title == 'Realized PnL') {
        final res = await http.get(Uri.parse('http://100.77.27.80:8553/api/stats/realized'), headers: headers);
        if (res.statusCode == 200) {
          setState(() { _extraData = jsonDecode(res.body); _isLoading = false; });
        } else {
          setState(() { _errorMsg = 'Failed'; _isLoading = false; });
        }
      } else {
        setState(() => _isLoading = false);
      }
    } catch (e) {
      setState(() { _errorMsg = 'Error: $e'; _isLoading = false; });
    }
  }

